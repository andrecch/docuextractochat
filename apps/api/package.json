{
  "name": "@docuextractochat/api",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "migrate": "node dist/src/database/migrate.js",
    "test": "npm run build && node test/run-jest.cjs --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "express": "5.1.0",
    "mammoth": "1.13.0",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.0",
    "typeorm": "0.3.31",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.0.0",
    "@types/pg": "8.18.0",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "6.0.3",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.0",
    "jest": "30.5.2",
    "supertest": "7.2.2",
    "yazl": "3.3.1"
  }
}
